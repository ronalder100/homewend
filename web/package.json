{
	"name": "homewend-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"tokens": "node scripts/tokens.js",
		"predev": "npm run tokens",
		"dev": "vite dev",
		"prebuild": "npm run tokens",
		"build": "vite build",
		"postbuild": "node -e \"require('fs').writeFileSync('../internal/web/dist/.gitkeep', '')\"",
		"check": "npm run tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.51.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
